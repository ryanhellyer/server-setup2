# Secrets
.env

# Runtime marker (setup.sh writes this to mark a tarball install)
.tarball
.last-sha

# Certificates (issued on the server)
env/letsencrypt/

# Generated site scaffolds / backups
maria/init/*.sql
!maria/init/example.sql

# Rendered configs (regenerated by scripts/render-config.sh at deploy time;
# edit the matching .template files instead)
/maria/my.cnf
/nginx/nginx.conf
/php/fpm-www.conf

# Local logs / caches
*.log

# Temp-backup: backup scripts + configs are versioned, but these stay local:
#   credentials (Gmail app password, MySQL pass)
/temp-backup/backups/secrets.env
#   downloaded mailboxes
/temp-backup/backups/getmail/oldmail-*
#   transient cron/backup logs
/temp-backup/*.log