# PHP-FPM container — ubuntu 24.04 + PHP 8.5 (ondrej PPA) + extensions.
#
# A SINGLE shared PHP-FPM container serves every site (Laravel + WordPress).
# Add a second container ONLY if a site truly needs a different PHP version.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# ondrej/php provides php8.5 on Ubuntu 24.04.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates gnupg lsb-release \
    && add-apt-repository -y ppa:ondrej/php \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        php8.5-fpm \
        php8.5-cli \
        php8.5-mysql \
        php8.5-mbstring \
        php8.5-zip \
        php8.5-intl \
        php8.5-imagick \
        php8.5-gd \
        php8.5-curl \
        php8.5-dom \
        php8.5-xml \
        php8.5-redis \
        php8.5-sqlite3 \
        php8.5-opcache \
        composer \
        wp-cli \
        ffmpeg \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Versioned overrides (also bind-mounted read-only from compose).
COPY 10-opcache.ini      /etc/php/8.5/fpm/conf.d/10-opcache.ini
COPY 20-fpm-security.ini /etc/php/8.5/fpm/conf.d/20-fpm-security.ini
COPY fpm-www.conf        /etc/php/8.5/fpm/pool.d/www.conf

# Site files live on the host under /var/www and are bind-mounted in.
WORKDIR /var/www

EXPOSE 9000
CMD ["php-fpm8.5", "-F"]