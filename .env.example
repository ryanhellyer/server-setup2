# Copy to .env and fill in real values. NEVER commit .env.

# ---- Deployment mode ----
# test        = 2 GB test box: Valkey capped at 64 MB, real TLS only for
#               ionos.hellyer.kiwi, fake placeholder sites + temporary
#               self-signed certs for every domain (no manual code removal
#               needed before going to production).
# production  = full stack, real certs for every domain, no fake content.
DEPLOY_ENV=test

# Nginx fastcgi cache keys_zone (RAM for cache keys).
# 64m is plenty for a test box; 500m on production with lots of traffic.
FASTCGI_CACHE_SIZE=64m

# ---- MariaDB sizing ----
# Test (2 GB): 256M buffer pool. Production (16 GB): MARIADB_BUFFER_POOL=8G.
MARIADB_BUFFER_POOL=256m
MARIADB_LOG_SIZE=64m

# ---- PHP-FPM sizing ----
# Test (2 GB): 20 children / 128M each. Production (16 GB, 8 cores):
#   PHP_FPM_MAX_CHILDREN=50, PHP_FPM_MEMORY_LIMIT=256M
PHP_FPM_MAX_CHILDREN=20
PHP_FPM_START_SERVERS=4
PHP_FPM_MIN_SPARE=4
PHP_FPM_MAX_SPARE=10
PHP_FPM_MEMORY_LIMIT=128M

# ---- Database ----
MARIADB_ROOT_PASSWORD=change-me-strong-password

# ---- Let's Encrypt ----
CERTBOT_EMAIL=admin@hellyer.kiwi
# Which cert list to issue (test = only ionos.hellyer.kiwi).
CERTBOT_DOMAINS_FILE=certbot/domains.test.txt

# ---- Valkey (drop-in Redis replacement) ----
# Test server: 64 MB. Raise to 1024mb on the production box.
VALKEY_MAXMEMORY=64mb

# ---- Swap (small boxes only) ----
# A 2G swapfile is created automatically on hosts with no swap. Production
# with plenty of RAM can leave this alone.
SWAP_SIZE=2G

# ---- Site files ----
# Host location of the web roots. Defaults to the admin user's home (~/www),
# e.g. /home/ryan/www, which keeps the data on the home partition (friendlier
# to atomic/immutable distros like Fedora Silverblue). It is bind-mounted into
# the containers at /var/www, so the nginx config is unaffected.
#WWW_ROOT=/home/ryan/www

# ---- Backup offload (optional) ----
# sshfs/rsync target on Hetzner storage box, e.g. user@storage.yourid.yourbox.de:/backup
HETZNER_SSH=

# ---- Site import from the Hetzner storage box (scripts/sync-site.sh) ----
# Pulls a site snapshot from the storage box into the host web root on every
# deploy (see WWW_ROOT above). The box is reached with key auth
# (scripts/host-setup.sh generates ~/.ssh/hetzner_backup; add the .pub to the
# box once via Hetzner Robot). Leave SRC empty to disable the import.
HETZNER_SYNC_USER=u513410
HETZNER_SYNC_HOST=u513410.your-storagebox.de
HETZNER_SYNC_PORT=23
HETZNER_SYNC_KEY=/home/ryan/.ssh/hetzner_backup
HETZNER_SYNC_SRC=/home/pressabl/2026-08-27/spam-destroyer.com
HETZNER_SYNC_DEST=/home/ryan/www/spam-destroyer.hellyer.kiwi

# ---- Bulk site migration (scripts/provision-site.sh / migrate-sites.sh) ----
# Dated snapshot of the old /var/www on the storage box (the site FILES).
HETZNER_SNAPSHOT_DIR=/home/pressabl/2026-08-27
# Local directory holding the weekly DB dumps, e.g. the ~/databases mount.
DB_DUMP_DIR=/home/ryan/databases

# ---- Open WebUI (chat.hellyer.kiwi) ----
# Public URL of the Open WebUI instance (passed to the container as WEBUI_URL).
OPENWEBUI_URL=https://chat.hellyer.kiwi
# OpenRouter API key for Open WebUI. Left blank here; provision-openwebui.sh
# fills it from the old install.sh on the storage box. NEVER commit a real key.
OPENROUTER_API_KEY=
# Optional: pin the snapshot date for the Open WebUI data (default: newest
# dated dir under OPENWEBUI_SNAPSHOT_ROOT that contains chat.hellyer.kiwi).
#OPENWEBUI_SNAPSHOT_ROOT=/home/pressabl

# ---- Hetzner Storage Box access (scripts/hetzner-mounts.sh) ----
# Sets up passwordless key access to BOTH boxes, and mounts the u458814 box's
# /home/gmail and /home/databases at ~/gmail and ~/databases via sshfs. The
# u513410 box is authorised but not mounted. Defaults already match; only set
# these to override.
#HETZNER_PRESSABL_HOST=u458814.your-storagebox.de
#HETZNER_PRESSABL_USER=u458814
#HETZNER_SECONDARY_HOST=u513410.your-storagebox.de
#HETZNER_SECONDARY_USER=u513410
#HETZNER_SSH_PORT=23
# Target home for the mounts (default: the invoking user's home, e.g. /home/ryan)
#HETZNER_MOUNT_HOME=
# SSH key used for passwordless access (generated automatically if missing)
#HETZNER_IDENTITY_FILE=

# ---- Site secrets (used by scripts/new-site.sh and maria init scripts) ----
# One entry per site, injected at site-creation time.
# SITE_DB_PASSWORD_<DOMAIN>=...   (generated by new-site.sh into this file)