# Shared TLS/SSL settings.
# Included once from nginx.conf (http block) and inherited by every vhost.
# Change once -> every site follows.

ssl_protocols TLSv1.2 TLSv1.3;
ssl_ciphers EECDH+CHACHA20:EECDH+AES;
ssl_ecdh_curve X25519:prime256v1:secp521r1:secp384r1;
ssl_prefer_server_ciphers on;

# Session resumption (shared across workers).
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

# OCSP stapling needs a resolver at runtime. Podman's netavark DNS runs on the
# network gateway: 10.89.0.1 for the `web` network and 10.89.1.1 for `backend`
# (see each container's /etc/resolv.conf). Docker's 127.0.0.11 does NOT exist
# here, and pointing at it makes every resolver lookup hang. If your networks
# use different subnets, override NGINX_DNS in .env (rendered by render-config).
resolver __NGINX_DNS__ valid=300s ipv6=off;
ssl_stapling on;
ssl_stapling_verify on;

# If you keep a dhparam.pem, prefer at least 2048 bits:
#   openssl dhparam -out /etc/nginx/dhparam.pem 2048
# (The cipher suite above is ECDHE-only, so DHE params are not currently used.)